# Copy to .env.local (development) or set in your hosting provider.
# Never commit real secrets.

# --- Required in production -------------------------------------------------
# Secret used to sign session tokens (>= 32 random characters).
# Generate one with:  openssl rand -base64 48
# Without it, sign-in is disabled in production (the site still works anonymously).
AUTH_SECRET=

# PostgreSQL with the pgvector extension. Without it the app runs on a
# non-persistent in-memory store (data is lost on restart / cold start).
# Apply the schema with:  pnpm db:migrate
DATABASE_URL=

# Public base URL (robots.txt, sitemap, Open Graph). On Vercel this falls back
# to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_APP_URL=

# --- AI providers (optional) -------------------------------------------------
# With neither key set, answers are deterministic quotes of the retrieved passages.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Model overrides (defaults shown)
# OPENAI_CHAT_MODEL=gpt-5.4-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# GOOGLE_CHAT_MODEL=gemini-flash-latest
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
# ENABLE_QUERY_REWRITE=true

# --- Rate limiting (recommended for serverless) ------------------------------
# Upstash Redis REST credentials (Vercel KV variable names also work:
# KV_REST_API_URL / KV_REST_API_TOKEN). Falls back to an in-process limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Accounts ---------------------------------------------------------------
# Comma-separated e-mails that get the ADMIN role (can manage the public demo KB).
ADMIN_EMAILS=
# Sandboxed demo profiles (Admin / Member / Guest) on the login page.
ENABLE_DEMO_LOGIN=true
# Auto-populate the public demo knowledge base with sample documents when empty.
SEED_DEMO_KB=true
